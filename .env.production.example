# Formal platform. Copy to .env.production.local and replace all local-only values.
PLATFORM_ENV=production
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3200
DATABASE_HOST_PORT=5433
DATABASE_ADMIN_URL=postgres://ai_tool_workbench:replace-me@127.0.0.1:5433/postgres
DATABASE_NAME=ai_tool_workbench_production
DATABASE_URL=postgres://ai_tool_workbench:replace-me@127.0.0.1:5433/ai_tool_workbench_production
DATABASE_USER=ai_tool_workbench
DATABASE_PASSWORD=replace-with-a-long-random-password
# The API uses the container path; backup/restore uses the absolute host path.
PLATFORM_STORAGE_ROOT=/data/platform
PLATFORM_STORAGE_HOST_ROOT=/srv/ai-tool-workbench/data
SESSION_COOKIE_NAME=atw_production_session
SESSION_HOURS=12
ACTIVATION_HOURS=72
COOKIE_SECURE=true
NEXT_PUBLIC_PLATFORM_ENV=production
API_INTERNAL_URL=http://127.0.0.1:3200

# Create the first administrator only after the formal platform is ready.
BOOTSTRAP_ORGANIZATION=公司名称
BOOTSTRAP_ADMIN_ACCOUNT=admin
BOOTSTRAP_ADMIN_NAME=平台管理员

# Formal environments must not use external-dev.
AI_PROVIDER=mock
EXTERNAL_AI_DATA_MODE=disabled
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000

# Backup scripts. Keep BACKUP_ROOT on a different disk or internal backup target.
BACKUP_ROOT=/srv/ai-tool-workbench-backups
