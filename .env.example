# Test platform
PLATFORM_ENV=test
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3100
DATABASE_URL=postgres://ai_tool_workbench:change-me@127.0.0.1:5432/ai_tool_workbench
PLATFORM_STORAGE_ROOT=var/test
SESSION_COOKIE_NAME=atw_test_session
SESSION_HOURS=12
ACTIVATION_HOURS=72
COOKIE_SECURE=false
NEXT_PUBLIC_PLATFORM_ENV=test
API_INTERNAL_URL=http://127.0.0.1:3100

# One-time bootstrap command
BOOTSTRAP_ORGANIZATION=公司名称
BOOTSTRAP_ADMIN_ACCOUNT=admin
BOOTSTRAP_ADMIN_NAME=平台管理员

# AI. external-dev only accepts sanitized test data and is blocked in production.
# Never commit a real personal key or send internal data to an external model.
AI_PROVIDER=mock
EXTERNAL_AI_DATA_MODE=disabled
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
